{
  "entities": {
    "users": {
      "title": "User",
      "description": "User account with translation credits, subscription status, and usage metrics",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "Firebase Auth UID" },
        "email": { "type": "string", "format": "email" },
        "displayName": { "type": "string" },
        "photoURL": { "type": "string" },
        "role": { "type": "string", "enum": ["user", "vip", "admin"] },
        "tier": { "type": "string", "enum": ["free", "pro", "unlimited"] },
        "credits": { "type": "number", "description": "Remaining translation credits (lines of subtitles)" },
        "totalTranslatedLines": { "type": "number", "description": "Cumulative lines translated by user" },
        "isVip": { "type": "boolean" },
        "vipExpiresAt": { "type": "string", "format": "date-time" },
        "planName": { "type": "string", "description": "Name of purchased subscription plan" },
        "planExpiresAt": { "type": "string", "format": "date-time", "description": "ISO timestamp when the active plan expires" },
        "customGeminiKeys": {
          "type": "array",
          "description": "User saved custom Gemini API keys from different Google Cloud projects",
          "items": {
            "type": "object",
            "properties": {
              "id": { "type": "string" },
              "label": { "type": "string" },
              "key": { "type": "string" },
              "projectName": { "type": "string" },
              "addedAt": { "type": "string", "format": "date-time" }
            }
          }
        },
        "createdAt": { "type": "string", "format": "date-time" },
        "lastLoginAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "email", "credits"]
    },
    "promoCodes": {
      "title": "Promo Code / Voucher",
      "description": "Redeemable promo codes for purchasing credits or VIP access",
      "type": "object",
      "properties": {
        "code": { "type": "string" },
        "credits": { "type": "number" },
        "isVipUpgrade": { "type": "boolean" },
        "maxUses": { "type": "number" },
        "usedCount": { "type": "number" },
        "redeemedUsers": {
          "type": "array",
          "items": { "type": "string" },
          "description": "UIDs of users who have redeemed this code"
        },
        "isActive": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["code", "credits", "isActive"]
    },
    "usageLogs": {
      "title": "Usage Log",
      "description": "History of translation credits used or promo codes redeemed",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "userEmail": { "type": "string" },
        "linesCount": { "type": "number" },
        "action": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "linesCount", "action"]
    },
    "systemConfig": {
      "title": "System Configuration & Key Store",
      "description": "Cloud Firestore persistent storage for admin Gemini Key Pool, VIP Access Keys, Donation accounts, and System Settings",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "Document ID (e.g. gemini_key_pool, usage_config, donation_config)" },
        "geminiKeyPool": {
          "type": "array",
          "description": "Admin Gemini API key pool for multi-key load balancing and auto-failover",
          "items": {
            "type": "object",
            "properties": {
              "id": { "type": "string" },
              "key": { "type": "string" },
              "label": { "type": "string" },
              "status": { "type": "string" },
              "cooldownUntil": { "type": "number" },
              "successCount": { "type": "number" },
              "errorCount": { "type": "number" },
              "usedLines": { "type": "number" },
              "todayUsedLines": { "type": "number" },
              "totalCalls": { "type": "number" },
              "lastUsedAt": { "type": "string" },
              "lastErrorMsg": { "type": "string" },
              "createdAt": { "type": "string" }
            }
          }
        },
        "strategy": { "type": "string" },
        "accessKeys": { "type": "array" },
        "updatedAt": { "type": "string" },
        "updatedBy": { "type": "string" }
      },
      "required": ["id"]
    }
  },
  "firestoreRules": "firestore.rules"
}
